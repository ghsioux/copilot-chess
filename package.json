{
  "name": "copilot-chess",
  "version": "1.0.0",
  "description": "A simple chess game powered by Copilot SDK with three difficulty levels",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/vscode-jsonrpc/package.json';if(fs.existsSync(p)){const d=JSON.parse(fs.readFileSync(p));if(!d.exports||!d.exports['./node.js']){d.exports={'.':'./lib/node/main.js','./node':'./node.js','./node.js':'./node.js','./browser':'./browser.js','./browser.js':'./browser.js'};fs.writeFileSync(p,JSON.stringify(d,null,2))}}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@github/copilot-sdk": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "chess.js": "^1.4.0",
    "express": "^5.2.1"
  }
}
